# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./choreo.db
# DATABASE_URL=postgresql://user:password@localhost:5432/choreo

# Secret key for session signing (change in production)
SECRET_KEY=dev-secret-change-in-production

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Alert threshold (1.25 = 25% over projected hours)
ALERT_THRESHOLD=1.25
